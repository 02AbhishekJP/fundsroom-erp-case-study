{
	"info": {
		"_postman_id": "fundsroom-erp-crm-collection-2024",
		"name": "Fundsroom ERP & CRM APIs",
		"description": "Postman Collection for Fundsroom Mini ERP + CRM Portal REST APIs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@fundsroom.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": ["{{base_url}}"],
							"path": ["auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "Customers (CRM)",
			"item": [
				{
					"name": "List Customers",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/customers?page=1&limit=10&status=active",
							"host": ["{{base_url}}"],
							"path": ["customers"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" },
								{ "key": "status", "value": "active" }
							]
						}
					}
				},
				{
					"name": "Create Customer",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Apex Industries\",\n  \"email\": \"contact@apex.com\",\n  \"phone\": \"+91-9988776655\",\n  \"company\": \"Apex Corp\",\n  \"status\": \"lead\",\n  \"type\": \"wholesale\",\n  \"notes\": \"Interested in high-pressure valves\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/customers",
							"host": ["{{base_url}}"],
							"path": ["customers"]
						}
					}
				}
			]
		},
		{
			"name": "Products & Inventory",
			"item": [
				{
					"name": "List Products",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/products",
							"host": ["{{base_url}}"],
							"path": ["products"]
						}
					}
				},
				{
					"name": "Adjust Stock (IN/OUT)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"IN\",\n  \"quantity\": 50,\n  \"reason\": \"Supplier Restock batch #992\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/products/{{product_id}}/stock",
							"host": ["{{base_url}}"],
							"path": ["products", "{{product_id}}", "stock"]
						}
					}
				}
			]
		},
		{
			"name": "Sales Challans",
			"item": [
				{
					"name": "Create Draft Challan",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customer_id\": \"{{customer_id}}\",\n  \"notes\": \"Urgent shipment required\",\n  \"items\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"quantity\": 5\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/challans",
							"host": ["{{base_url}}"],
							"path": ["challans"]
						}
					}
				},
				{
					"name": "Confirm Challan (Deduct Stock)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/challans/{{challan_id}}/confirm",
							"host": ["{{base_url}}"],
							"path": ["challans", "{{challan_id}}", "confirm"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000/api"
		}
	]
}
